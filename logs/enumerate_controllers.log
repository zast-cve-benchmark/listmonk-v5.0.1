2026-04-07 16:25:25.310 | ToolRes  | langchain_zast.agents.claude.agent:_log:249 - ToolResult:      1→# Echo Endpoint Enumeration Reference
     2→
     3→## Overview
     4→
     5→Echo is a high-performance Go web framework. Routes are registered on `echo.Echo` or `echo.Group`. This guide covers all patterns for enumerating API endpoints in Echo applications.
     6→
     7→---
     8→
     9→## 1. Route Registration Methods
    10→
    11→### 1.1 HTTP Method Functions
    12→
    13→| Method | HTTP Method | Description |
    14→|--------|-------------|-------------|
    15→| `e.GET()` | GET | Retrieve data |
    16→| `e.POST()` | POST | Create resource |
    17→| `e.PUT()` | PUT | Replace resource |
    18→| `e.DELETE()` | DELETE | Delete resource |
    19→| `e.PATCH()` | PATCH | Partial update |
    20→| `e.OPTIONS()` | OPTIONS | CORS preflight |
    21→| `e.HEAD()` | HEAD | Headers only |
    22→| `e.Match()` | Multiple | Match specified methods |
    23→| `e.Any()` | All | Match all methods |
    24→
    25→### 1.2 Basic Route Registration
    26→
    27→```go
    28→package main
    29→
    30→import (
    31→    "net/http"
    32→    "github.com/labstack/echo/v5"
    33→)
    34→
    35→func main() {
    36→    e := echo.New()
    37→
    38→    // Basic routes
    39→    e.GET("/users", getUsers)
    40→    e.POST("/users", createUser)
    41→    e.GET("/users/:id", getUser)
    42→    e.PUT("/users/:id", updateUser)
    43→    e.DELETE("/users/:id", deleteUser)
    44→
    45→    // Match multiple methods
    46→    e.Match([]string{"GET", "POST"}, "/api/data", handleData)
    47→
    48→    // Match all methods
    49→    e.Any("/webhook", handleWebhook)
    50→
    51→    e.Start(":8080")
    52→}
    53→```
    54→
    55→---
    56→
    57→## 2. Router Groups
    58→
    59→### 2.1 Basic Grouping
    60→
    61→```go
    62→func main() {
    63→    e := echo.New()
    64→
    65→    // API v1 group
    66→    v1 := e.Group("/api/v1")
    67→    v1.GET("/users", listUsersV1)
    68→    v1.GET("/users/:id", getUserV1)
    69→
    70→    // Group with middleware
    71→    v2 := e.Group("/api/v2", middleware.RequestLogger())
    72→    v2.GET("/users", listUsersV2)
    73→    v2.GET("/users/:id", getUserV2)
    74→
    75→    e.Start(":8080")
    76→}
    77→```
    78→
    79→### 2.2 Nested Groups
    80→
    81→```go
    82→func main() {
    83→    e := echo.New()
    84→
    85→    // Admin group with middleware
    86→    admin := e.Group("/admin", authMiddleware)
    87→    admin.GET("/stats", getStats)
    88→    admin.POST("/config", updateConfig)
    89→
    90→    // Nested group
    91→    users := admin.Group("/users")
    92→    users.GET("", listAllUsers)
    93→    users.DELETE("/:id", deleteUser)
    94→
    95→    e.Start(":8080")
    96→}
    97→```
    98→
    99→---
   100→
   101→## 3. Path Parameters
   102→
   103→### 3.1 Named Parameters
   104→
   105→```go
   106→// Single parameter
   107→e.GET("/users/:id", func(c *echo.Context) error {
   108→    id := c.Param("id")
   109→    return c.JSON(http.StatusOK, map[string]string{"id": id})
   110→})
   111→
   112→// Multiple parameters
   113→e.GET("/users/:userId/posts/:postId", func(c *echo.Context) error {
   114→    userId := c.Param("userId")
   115→    postId := c.Param("postId")
   116→    return c.JSON(http.StatusOK, map[string]string{
   117→        "userId": userId,
   118→        "postId": postId,
   119→    })
   120→})
   121→```
   122→
   123→### 3.2 Wildcard Parameters
   124→
   125→```go
   126→// Wildcard captures everything after prefix
   127→e.GET("/files/*", func(c *echo.Context) error {
   128→    filepath := c.Param("*") // "images/logo.png"
   129→    return c.String(http.StatusOK, "File: "+filepath)
   130→})
   131→```
   132→
   133→### 3.3 Query Parameters
   134→
   135→```go
   136→e.GET("/search", func(c *echo.Context) error {
   137→    name := c.QueryParam("name")
   138→    page := c.QueryParamDefault("page", "1")
   139→    return c.JSON(http.StatusOK, map[string]string{
   140→        "name": name,
   141→        "page": page,
   142→    })
   143→})
   144→```
   145→
   146→### 3.4 Type-Safe Parameter Extraction (Echo v5)
   147→
   148→```go
   149→// Type-safe path parameter
   150→e.GET("/users/:id", func(c *echo.Context) error {
   151→    id, err := echo.PathParam[int](c, "id")
   152→    if err != nil {
   153→        return err
   154→    }
   155→    return c.JSON(http.StatusOK, map[string]int{"id": id})
   156→})
   157→
   158→// Struct binding
   159→type PathParams struct {
   160→    UserID string `param:"user_id"`
   161→    PostID int    `param:"post_id"`
   162→}
   163→
   164→e.GET("/users/:user_id/posts/:post_id", func(c echo.Context) error {
   165→    params := new(PathParams)
   166→    if err := echo.BindPathValues(c, params); err != nil {
   167→        return err
   168→    }
   169→    return c.JSON(http.StatusOK, params)
   170→})
   171→```
   172→
   173→---
   174→
   175→## 4. Middleware
   176→
   177→### 4.1 Global Middleware
   178→
   179→```go
   180→func main() {
   181→    e := echo.New()
   182→
   183→    // Pre-middleware (before routing)
   184→    e.Pre(middleware.AddTrailingSlash())
   185→
   186→    // Global middleware (after routing)
   187→    e.Use(middleware.Logger())
   188→    e.Use(middleware.Recover())
   189→    e.Use(middleware.CORS())
   190→
   191→    e.Start(":8080")
   192→}
   193→```
   194→
   195→### 4.2 Group Middleware
   196→
   197→```go
   198→// Middleware applies to group
   199→api := e.Group("/api", middleware.RequestID())
   200→api.GET("/data", apiHandler)
   201→```
   202→
   203→### 4.3 Route-Level Middleware
   204→
   205→```go
   206→e.GET("/public", publicHandler)
   207→e.GET("/protected", protectedHandler, authMiddleware())
   208→```
   209→
   210→### 4.4 Custom Middleware
   211→
   212→```go
   213→func authMiddleware() echo.MiddlewareFunc {
   214→    return func(next echo.HandlerFunc) echo.HandlerFunc {
   215→        return func(c *echo.Context) error {
   216→            token := c.Request().Header.Get("Authorization")
   217→            if token == "" {
   218→                return echo.ErrUnauthorized
   219→            }
   220→            return next(c)
   221→        }
   222→    }
   223→}
   224→```
   225→
   226→---
   227→
   228→## 5. Handler Signatures
   229→
   230→### 5.1 Echo v5 Handler
   231→
   232→```go
   233→// v5 handler signature (Context is a pointer)
   234→func getUsers(c *echo.Context) error {
   235→    // Path parameter
   236→    id := c.Param("id")
   237→
   238→    // Query parameter
   239→    name := c.QueryParam("name")
   240→
   241→    // Request body
   242→    var user User
   243→    if err := c.Bind(&user); err != nil {
   244→        return err
   245→    }
   246→
   247→    // Response
   248→    return c.JSON(http.StatusOK, map[string]interface{}{
   249→        "data": users,
   250→    })
   251→}
   252→```
   253→
   254→---
   255→
   256→## 6. Locating Handler Functions
   257→
   258→### 6.1 AST Search Patterns
   259→
   260→```go
   261→// Search for route registration
   262→ast_grep_search(pattern='e.GET($PATH, $HANDLER)', lang='go')
   263→ast_grep_search(pattern='e.POST($PATH, $HANDLER)', lang='go')
   264→ast_grep_search(pattern='e.PUT($PATH, $HANDLER)', lang='go')
   265→ast_grep_search(pattern='e.DELETE($PATH, $HANDLER)', lang='go')
   266→ast_grep_search(pattern='e.Any($PATH, $HANDLER)', lang='go')
   267→ast_grep_search(pattern='e.Match($METHODS, $PATH, $HANDLER)', lang='go')
   268→
   269→// Search for group creation
   270→ast_grep_search(pattern='$VAR := e.Group($PATH)', lang='go')
   271→
   272→// Search for middleware
   273→ast_grep_search(pattern='e.Use($MIDDLEWARE)', lang='go')
   274→ast_grep_search(pattern='e.Pre($MIDDLEWARE)', lang='go')
   275→```
   276→
   277→### 6.2 Regex Search Patterns
   278→
   279→```regex
   280→\.(GET|POST|PUT|DELETE|PATCH|Any|Match)\s*\(
   281→\.Group\s*\(
   282→\.Use\s*\(
   283→\.Pre\s*\(
   284→c\.Param\s*\(
   285→c\.QueryParam\s*\(
   286→```
   287→
   288→### 6.3 Key Files to Check
   289→
   290→| Directory | Purpose |
   291→|-----------|---------|
   292→| `main.go` | Application entry |
   293→| `routes/` | Route definitions |
   294→| `handlers/` | Handler functions |
   295→| `controllers/` | Controller logic |
   296→| `api/` | API endpoints |
   297→
   298→---
   299→
   300→## 7. Security Audit Checklist
   301→
   302→- [ ] Identify all `e.GET/POST/PUT/DELETE` calls
   303→- [ ] Trace router groups and their prefixes
   304→- [ ] Check middleware application (global, group, route)
   305→- [ ] Verify path parameter validation
   306→- [ ] Check wildcard routes for path traversal risks
   307→- [ ] Review `Any()` and `Match()` for unintended exposure
   308→- [ ] Check `Pre` vs `Use` middleware ordering
   309→- [ ] Verify authentication middleware coverage
